(module
  (import "env" "shared" (memory $sh 1 1 shared))
  (import "wasi" "thread-spawn" (func $spawn (param i32) (result i32)))
  (memory $m0 1)
  (export "memory" (memory $sh))
  (tag $abort (param i32))
  (func $rec (param $n i32) (result i32)
    (if (result i32) (i32.eqz (local.get $n)) (then (throw $abort (i32.const 42)))
      (else (i32.add (i32.const 1) (call $rec (i32.sub (local.get $n) (i32.const 1)))))))
  (func (export "wasi_thread_start") (param $tid i32) (param $arg i32) (local $v i32)
    (local.set $v (block $caught (result i32)
      (try_table (catch $abort $caught)
        (drop (call $rec (local.get $arg))))
      (i32.const 0)))
    (i32.atomic.store $sh (i32.const 4) (local.get $v))
    (drop (i32.atomic.rmw.add $sh (i32.const 0) (i32.const 1)))
    (drop (memory.atomic.notify $sh (i32.const 0) (i32.const -1))))
  (func (export "_start")
    (drop (call $spawn (i32.const 1000000)))
    (block $done (loop $l
      (br_if $done (i32.atomic.load $sh (i32.const 0)))
      (drop (memory.atomic.wait32 $sh (i32.const 0) (i32.const 0) (i64.const -1)))
      (br $l)))
    (if (i32.ne (i32.load $sh (i32.const 4)) (i32.const 42)) (then unreachable)))
)
