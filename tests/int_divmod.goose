fn main() {
    let ms: i64 = -9223372036854775807 - 1;
    print(-7 % 3, " ", 7 % -3, " ", -7 % -3, " ", ms % -1, " ", ms % 3, " ", 5 % ms, " ", -5 % ms);
    let a: i8 = -128;
    let b: i8 = -1;
    let c: i8 = 3;
    print(a % b, " ", a % c, " ", a / b, " ", (-7 as i16) % 4, " ", (-7 as i32) % -4);
    let u: u32 = 4000000000;
    print(u % 7, " ", u / 3);
}
